%% CDC-SPM interactive nominal spherical 3-RRR mechanism
% Save as CDC_SPM_interactive.m and run CDC_SPM_interactive in MATLAB.
% MATLAB R2019b or newer recommended.
% Axes/IK are built from the spherical closure equation v_i dot w_i = cos(alpha2).
% This is a geometric/schematic rigid-link viewer, NOT interference or
% singularity-validated CAD geometry. Units: mm, degrees.
function CDC_SPM_interactive
clc; close all;

%% ---------------- USER PARAMETERS ----------------
cfg.offset = [3.5 12 20.5];   % active-axis joint markers (mm)
cfg.alpha1 = 45;             % degrees, CoR-to-J2 radial axis versus downward vertical
cfg.zeta = 90;               % degrees, J3 azimuthal offset from J2 at home
cfg.r_eff = 8.5;             % tool radius mm
cfg.R2 = 26;               % J3 radius at neutral, mm
cfg.d2 = 40;                 % nominal height above first J1 marker, mm
cfg.L_tool = 219.075;        % physical tool length, mm
cfg.pivotToTip = 101.6;      % CoR-to-tip distance along +tool z, mm
cfg.L_eff = 88.10625;        % nominal J3 plane-to-CoR, mm
cfg.d6 = 29.36875;           % J2-to-J3 axial separation at home, mm
cfg.holderLength = 20;       % centered on J3/reference platform plane, mm
cfg.holderRadius = 12;       % mm
cfg.linkRadius12 = 4.0;      % J1-J2 visualization tube radius mm
cfg.linkRadius23 = 4.0;      % J2-J3 visualization tube radius mm

% Example: 625 deep-groove ball bearing
cfg.bearingID    = 5;    % mm
cfg.bearingOD    = 16;   % mm
cfg.bearingWidth = 5;    % mm

% Material surrounding bearing
cfg.housingWall  = 2.5;  % mm

cfg.jointRadius = cfg.bearingOD/2 + cfg.housingWall;         % joint ball radius mm




% Commanded tool orientation (degrees):
% Pitch has ergonomic neutral at 45 deg, with +/-45 deg excursion.
cfg.pitchNeutral = 45;
cfg.pitchMin = 0; cfg.pitchMax = 90;
% Roll about the tool's own longitudinal axis; total travel 90 degrees.
cfg.rollMin = -45; cfg.rollMax = 45;
% Yaw about the fixed world z axis; exploratory range only.
cfg.yawMin = -30; cfg.yawMax = 30;

% Optional motor travel constraint relative to the home position.
% Set to Inf to inspect closure without imposing an assumed motor stop.
cfg.motorLimitDeg = Inf;

%% ---------------- GEOMETRY ----------------
g = setupGeometry(cfg);
fprintf('\nHome configuration (nominal):\n');
fprintf('L_design %.3f mm; R1 %.3f mm; R2 %.3f mm\n',g.L_design,g.R1,cfg.R2);
fprintf('alpha1 %.3f deg; alpha2 %.3f deg; beta %.3f deg\n',cfg.alpha1,g.alpha2,g.beta);
fprintf('J1-J2 [%.2f %.2f %.2f] mm\n',g.L12home);
fprintf('J2-J3 [%.2f %.2f %.2f] mm\n',g.L23home);
fprintf('Neutral physical pitch = %.1f deg (zero mechanism pitch)\n',cfg.pitchNeutral);

%% ---------------- VIEWER ----------------
fig = figure('Name','CDC-SPM spherical wrist | interactive IK', ...
    'Color','w','Position',[80 80 1250 760]);
ax = axes('Parent',fig,'Position',[0.04 0.15 0.68 0.79]);
hold(ax,'on'); grid(ax,'on'); axis(ax,'equal'); view(ax,35,22);
xlabel(ax,'X (mm)'); ylabel(ax,'Y (mm)'); zlabel(ax,'Z (mm)');
set(ax,'Projection','perspective');
col = lines(3);

% Build all graphics once and update their vertices in place. This prevents
% the accumulation / rendering trails seen when rapidly moving the sliders.
% Keeping the same handles also preserves the camera and user zoom.
panelX = 0.77; panelW = 0.205;
sliderListeners = {};  % Keep slider listeners alive for continuous dragging
uicontrol(fig,'Style','text','Units','normalized','Position',[panelX .91 panelW .042], ...
    'String','Orientation controls (degrees)','BackgroundColor','w', ...
    'FontWeight','bold','HorizontalAlignment','left');

pitchSlider = makeSlider('Pitch (0 to 90)',cfg.pitchMin,cfg.pitchMax,cfg.pitchNeutral,.81);
yawSlider   = makeSlider('Yaw (-30 to 30)',cfg.yawMin,cfg.yawMax,0,.67);
rollSlider  = makeSlider('Roll (-45 to 45)',cfg.rollMin,cfg.rollMax,0,.53);
statusText = uicontrol(fig,'Style','text','Units','normalized', ...
    'Position',[panelX .26 panelW .19],'BackgroundColor','w', ...
    'HorizontalAlignment','left','FontSize',10,'String','');
uicontrol(fig,'Style','pushbutton','Units','normalized', ...
    'Position',[panelX .18 panelW .055],'String','Reset to home', ...
    'Callback',@resetPose);
uicontrol(fig,'Style','text','Units','normalized','BackgroundColor','w', ...
    'Position',[panelX .06 panelW .10], 'HorizontalAlignment','left', ...
    'String',sprintf(['Green: valid spherical closure\n', ...
    'Red: outside geometric IK or motor limit\n', ...
    'Mouse: rotate/zoom 3D axes']));

% One-time object construction. No surface is created/deleted on updates.
scene = createScene(ax,col);
reach = max([g.R1+40, cfg.L_tool+50, g.zCor+60]);
axis(ax,'equal');
xlim(ax,[-reach reach]); ylim(ax,[-reach reach]);
zlim(ax,[min(-40,g.zCor-cfg.L_tool-40), g.zCor+cfg.L_tool+40]);
set(ax,'XLimMode','manual','YLimMode','manual','ZLimMode','manual');

% Keep previous motor solution so a slider sweep stays on its IK branch.
lastPhi = zeros(1,3);
isRendering = false; % Guard against overlapping callbacks
renderPose();
rotate3d(fig,'on');

%% ---------------- NESTED GUI FUNCTIONS ----------------
function s = makeSlider(label,lo,hi,startVal,y)
    uicontrol(fig,'Style','text','Units','normalized','Position',[panelX y+.062 panelW .03], ...
        'String',label,'BackgroundColor','w','HorizontalAlignment','left');
    s = uicontrol(fig,'Style','slider','Units','normalized', ...
        'Position',[panelX y panelW .043], 'Min',lo,'Max',hi, ...
        'Value',startVal,'Callback',@(~,~)renderPose());
    % Continuous updates while dragging are supported on standard figures.
    try
        sliderListeners{end+1} = addlistener(s, ...
            'ContinuousValueChange',@(~,~)renderPose());
    catch
        % On versions without this event, updates happen on release.
    end
end

function resetPose(~,~)
    set(pitchSlider,'Value',cfg.pitchNeutral);
    set(yawSlider,'Value',0);
    set(rollSlider,'Value',0);
    lastPhi = [0 0 0];
    renderPose();
end

function renderPose()
    if ~isgraphics(ax) || isRendering, return; end
    isRendering = true;
    try
        pitch = get(pitchSlider,'Value');
        yaw = get(yawSlider,'Value');
        roll = get(rollSlider,'Value');

        % Home pitch is 45 degrees, corresponding to zero mechanism pitch.
        R = rotzDeg(yaw)*rotyDeg(pitch-cfg.pitchNeutral)*rotzDeg(roll);
        [ok,phi,V,W,reason] = solveSphericalIK(R,g,cfg,lastPhi);
        if ok
            lastPhi = phi;
        else
            % Show requested platform orientation, but retain the last
            % actuator solution. An invalid pose is NOT physical closure.
            phi = lastPhi;
            V = zeros(3,3);
            for i=1:3
                V(:,i)=rotzDeg(phi(i))*g.vHome(:,i);
            end
        end

        % Update geometry numerically; do not create or delete surfaces.
        CoR = g.CoR(:);
        J2 = CoR + g.rho2*V;
        J3 = CoR + g.rho3*W;
        toolTip = CoR + R*[0;0;cfg.pivotToTip];
        toolBase = CoR + R*[0;0;cfg.pivotToTip-cfg.L_tool];
        attach = CoR + R*[0;0;-cfg.L_eff];
        holderA = attach-R*[0;0;cfg.holderLength/2];
        holderB = attach+R*[0;0;cfg.holderLength/2];

        updateTube(scene.tool,toolBase,toolTip,cfg.r_eff);
        updateTube(scene.holder,holderA,holderB,cfg.holderRadius);

        for i=1:3
            updateTube(scene.link12(i),g.J1(:,i),J2(:,i),cfg.linkRadius12);
            updateTube(scene.link23(i),J2(:,i),J3(:,i),cfg.linkRadius23);
            updateMarker(scene.j1(i),g.J1(:,i));
            updateMarker(scene.j2(i),J2(:,i));
            updateMarker(scene.j3(i),J3(:,i));
            updateAxisLine(scene.axisV(i),CoR,V(:,i),20);
            updateAxisLine(scene.axisW(i),CoR,W(:,i),20);
        end
        updateMarker(scene.cor,CoR);
        updateMarker(scene.tip,toolTip);
        updateMarker(scene.attach,attach);

        % Axis and camera limits are NOT reset on slider updates.
        title(ax,sprintf('Pitch %.1f° | Yaw %.1f° | Roll %.1f°', ...
            pitch,yaw,roll));
        lengths12 = vecnorm(J2-g.J1,2,1);
        lengths23 = vecnorm(J3-J2,2,1);
        axisClosure = max(abs(sum(V.*W,1)-cosd(g.alpha2)));
        if ok
            tag = 'VALID spherical closure';
            statusColor = [.02 .45 .15];
        else
            tag = ['NOT REACHABLE: ' reason];
            statusColor = [.75 .08 .08];
        end
        set(statusText,'String',sprintf([ ...
            '%s\nMotor angles: [%.1f %.1f %.1f]°\n', ...
            'L12: %.1f / %.1f / %.1f mm\n', ...
            'L23: %.1f / %.1f / %.1f mm\n', ...
            'Axis-dot residual: %.2g'], ...
            tag,phi,lengths12,lengths23,axisClosure), ...
            'ForegroundColor',statusColor);
        drawnow nocallbacks;
    catch ME
        isRendering = false;
        rethrow(ME);
    end
    isRendering = false;
end
end

%% ---------------- LOCAL CALCULATION FUNCTIONS ----------------
function g=setupGeometry(c)
    if c.L_eff<=0 || c.d6<0 || c.R2<=0 || c.L_tool<=0
        error('Require L_eff>0, d6>=0, R2>0 and L_tool>0.');
    end
    if numel(c.offset)~=3 || ~(c.alpha1>0 && c.alpha1<90)
        error('Offsets must have 3 entries, alpha1 must be between 0 and 90 deg.');
    end
    g.L_design=c.L_eff+c.d6;
    g.R1=g.L_design*tand(c.alpha1);
    g.beta=atan2d(c.R2,c.L_eff);
    g.alpha2=acosd(max(-1,min(1,cosd(c.alpha1)*cosd(g.beta)+ ...
        sind(c.alpha1)*sind(g.beta)*cosd(c.zeta))));
    g.zCor=c.offset(1)+c.d2+g.L_design;
    g.CoR=[0;0;g.zCor];
    g.rho2=hypot(g.R1,g.L_design);
    g.rho3=hypot(c.R2,c.L_eff);
    theta=[0 120 240];
    g.J1=[zeros(2,3);reshape(c.offset,1,3)];
    g.J2home=[g.R1*cosd(theta);g.R1*sind(theta); ...
        (c.offset(1)+c.d2)*ones(1,3)];
    g.J3home=[c.R2*cosd(theta+c.zeta);c.R2*sind(theta+c.zeta); ...
        (g.zCor-c.L_eff)*ones(1,3)];
    g.vHome=(g.J2home-g.CoR)/g.rho2;
    g.wHome=(g.J3home-g.CoR)/g.rho3;
    g.L12home=vecnorm(g.J2home-g.J1,2,1);
    g.L23home=vecnorm(g.J3home-g.J2home,2,1);
    if c.pivotToTip<0 || c.pivotToTip>c.L_tool
        error('pivotToTip must be between 0 and L_tool.');
    end
end

function [ok,phi,V,W,reason]=solveSphericalIK(R,g,c,previousPhi)
    W=R*g.wHome;
    V=zeros(3,3); phi=zeros(1,3);
    ok=true;reason='';
    for i=1:3
        v=g.vHome(:,i); w=W(:,i);
        A=v(1)*w(1)+v(2)*w(2);
        B=v(1)*w(2)-v(2)*w(1);
        C=v(3)*w(3);
        target=cosd(g.alpha2)-C;
        mag=hypot(A,B);
        if mag<1e-10 || abs(target)>mag+1e-9
            ok=false;reason=sprintf('leg %d IK has no solution',i);
            phi(i)=previousPhi(i);
        else
            a=atan2d(B,A); offset=acosd(max(-1,min(1,target/mag)));
            candidate=[a+offset,a-offset];
            % Choose IK branch continuously closest to last sample.
            diffs=mod(candidate-previousPhi(i)+180,360)-180;
            [~,j]=min(abs(diffs));
            phi(i)=previousPhi(i)+diffs(j);
            if abs(phi(i))>c.motorLimitDeg
                ok=false;reason=sprintf('motor %d limit exceeded',i);
            end
        end
        V(:,i)=rotzDeg(phi(i))*v;
    end
    if ok && max(abs(sum(V.*W,1)-cosd(g.alpha2)))>1e-6
        ok=false; reason='axis angle closure residual';
    end
end

function h = createScene(ax,col)
% Create ALL surfaces, markers and axis lines exactly once.
% Subsequent slider moves only call set(handle,'XData',...) etc.
    n = 17;
    emptyMesh = nan(2,n);
    h.tool = surf(ax,emptyMesh,emptyMesh,emptyMesh, ...
        'FaceColor',[.45 .45 .45],'FaceAlpha',.23, ...
        'EdgeColor','none','HandleVisibility','off');
    h.holder = surf(ax,emptyMesh,emptyMesh,emptyMesh, ...
        'FaceColor',[.67 .2 .78],'FaceAlpha',.42, ...
        'EdgeColor','none','HandleVisibility','off');

    h.link12 = gobjects(3,1);
    h.link23 = gobjects(3,1);
    h.j1 = gobjects(3,1);
    h.j2 = gobjects(3,1);
    h.j3 = gobjects(3,1);
    h.axisV = gobjects(3,1);
    h.axisW = gobjects(3,1);
    for i=1:3
        h.link12(i) = surf(ax,emptyMesh,emptyMesh,emptyMesh, ...
            'FaceColor',col(i,:),'FaceAlpha',1, ...
            'EdgeColor','none','HandleVisibility','off');
        h.link23(i) = surf(ax,emptyMesh,emptyMesh,emptyMesh, ...
            'FaceColor',col(i,:),'FaceAlpha',1, ...
            'EdgeColor','none','HandleVisibility','off');
        h.j1(i) = plot3(ax,nan,nan,nan,'.','Color',col(i,:), ...
            'MarkerSize',18,'HandleVisibility','off');
        h.j2(i) = plot3(ax,nan,nan,nan,'o','Color',col(i,:), ...
            'MarkerFaceColor',col(i,:),'MarkerSize',7, ...
            'HandleVisibility','off');
        h.j3(i) = plot3(ax,nan,nan,nan,'s','Color',col(i,:), ...
            'MarkerFaceColor',col(i,:),'MarkerSize',7, ...
            'HandleVisibility','off');
        h.axisV(i) = plot3(ax,[nan nan],[nan nan],[nan nan], ...
            '--','Color',col(i,:),'LineWidth',.7,'HandleVisibility','off');
        h.axisW(i) = plot3(ax,[nan nan],[nan nan],[nan nan], ...
            '--','Color',col(i,:),'LineWidth',.7,'HandleVisibility','off');
    end
    h.cor = plot3(ax,nan,nan,nan,'kd','MarkerFaceColor','k', ...
        'MarkerSize',9,'HandleVisibility','off');
    h.tip = plot3(ax,nan,nan,nan,'ro','MarkerFaceColor','r', ...
        'MarkerSize',8,'HandleVisibility','off');
    h.attach = plot3(ax,nan,nan,nan,'ms','MarkerFaceColor','m', ...
        'MarkerSize',7,'HandleVisibility','off');
end

function updateAxisLine(h,origin,direction,halfLength)
    a=origin-halfLength*direction;
    b=origin+halfLength*direction;
    set(h,'XData',[a(1) b(1)],'YData',[a(2) b(2)], ...
        'ZData',[a(3) b(3)]);
end

function updateMarker(h,xyz)
    set(h,'XData',xyz(1),'YData',xyz(2),'ZData',xyz(3));
end

function updateTube(h,A,B,radius)
    [X,Y,Z]=tubeMesh(A,B,radius);
    set(h,'XData',X,'YData',Y,'ZData',Z);
end

function [X,Y,Z]=tubeMesh(A,B,radius)
    A=A(:); B=B(:);
    direction=B-A;
    L=norm(direction);
    if L<1e-8
        X=nan(2,17); Y=X; Z=X;
        return;
    end
    w=direction/L;
    seed=[0;0;1];
    if abs(dot(w,seed))>.9
        seed=[1;0;0];
    end
    u=cross(w,seed); u=u/norm(u);
    v=cross(w,u);
    t=linspace(0,2*pi,17);
    ring=radius*(u*cos(t)+v*sin(t));
    X=[A(1)+ring(1,:); B(1)+ring(1,:)];
    Y=[A(2)+ring(2,:); B(2)+ring(2,:)];
    Z=[A(3)+ring(3,:); B(3)+ring(3,:)];
end

function R=rotzDeg(a)
    R=[cosd(a) -sind(a) 0;sind(a) cosd(a) 0;0 0 1];
end
function R=rotyDeg(a)
    R=[cosd(a) 0 sind(a);0 1 0;-sind(a) 0 cosd(a)];
end
