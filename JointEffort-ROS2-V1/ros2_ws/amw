#!/usr/bin/env python3
"""The `amw` command. Works from any folder:  path/to/ros2_ws/amw --help

Tip: add this folder to your PATH (or alias amw=...) so you can type just `amw`. See docs/setup.md.
"""
import os
import sys
from pathlib import Path

WS = Path(__file__).resolve().parent
os.environ.setdefault('AMW_WS', str(WS))
sys.path.insert(0, str(WS / 'src/amw_tools'))

from amw_tools.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]) or 0)
