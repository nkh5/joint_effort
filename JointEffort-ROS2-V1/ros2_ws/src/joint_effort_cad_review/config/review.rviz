Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: base_link
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: CAD reference grid
      Cell Size: 0.1
    - Class: rviz_default_plugins/RobotModel
      Name: CAD visuals when meshes supplied
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /cad_review/robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: CAD joint and tip coordinate frames
      Enabled: true
      Show Axes: true
      Show Arrows: true
      Show Names: true
      Marker Scale: 0.25
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.0
      Focal Point: {X: -0.15, Y: 0, Z: 0.2}
      Pitch: 0.5
      Yaw: 0.8
