  <version>1.0.0</version>
  <description>AMW launch file and configuration (arm.yaml, controllers, Servo, input).</description>
  <maintainer email="jp165@rice.edu">Joint Effort</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
